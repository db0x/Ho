# Vorlage fuer eine .env neben docker-compose.yml. Kopieren, anpassen:
#   cp .env.example .env
# Die .env selbst steht in .gitignore und gehoert nicht ins Repo.

# Anmeldung vor der Lobby. Lokal abschalten, auf dem Server die Zeile weglassen
# oder auf "on" lassen - fehlt sie, ist die Anmeldung an.
HO_AUTH=off

# Port auf dem Host. Hinter einem Reverse-Proxy HOST_BIND=127.0.0.1 setzen,
# damit nur der Proxy herankommt.
#HOST_PORT=8080
#HOST_BIND=0.0.0.0
