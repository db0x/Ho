# Template for a .env next to docker-compose.yml. Copy and adjust:
#   cp .env.example .env
# The .env itself is listed in .gitignore and does not belong in the repo.

# Sign-in in front of the lobby. Switch it off locally; on the server leave
# this line out or set it to "on" - if it is missing, sign-in is on.
HO_AUTH=off

# Port on the host. Behind a reverse proxy set HOST_BIND=127.0.0.1 so that
# only the proxy can reach it.
#HOST_PORT=8080
#HOST_BIND=0.0.0.0

# CB radio: push-to-talk voice directly between the players. Off unless
# switched on; the game leader then opens it in each game.
#HO_VOICE=on
# STUN for the CB radio on UDP (port on the host). HO_STUN_URL only if the
# browsers reach it under another name than the page, e.g. stun:ho.example.org:3478
#STUN_PORT=3478
#HO_STUN_URL=
